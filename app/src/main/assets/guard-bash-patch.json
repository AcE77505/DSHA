{
  "version": 1,
  "dshVersion": "0.2.0-rc.2",
  "module": "@deepseek-ai/dsh-tool-bash/lib/index.js",
  "patches": [
    {
      "before": "import z from \"@deepseek-ai/schemastery\";",
      "after": "import { preparedEnvironment, verifyBashRequest } from \"dsha-destructive-policy\"; // DSHA_REQUIRED_POLICY_V1\nimport z from \"@deepseek-ai/schemastery\";"
    },
    {
      "before": "\t\t\t\tconst dshEnv = ctx.shellEnv.collect(exec);",
      "after": "\t\t\t\tverifyBashRequest(exec, workdir);\n\t\t\t\tconst dshEnv = preparedEnvironment(exec);"
    }
  ]
}
